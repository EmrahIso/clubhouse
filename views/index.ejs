<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <title>ClubHouse | <%= title %></title>
  </head>
  <body>
    <% console.log('loggedIn:', loggedIn); %>
    <% if (loggedIn) { %>
      <div class="form-container" style="margin: 2rem auto; max-width: 600px;">
        <h2>Welcome to ClubHouse!</h2>
        <div style="display: flex; justify-content: space-between;">
          <a href="/members" class="btn-header" style="margin-right: 0.5rem;">Members Area</a>
          <a href="/log-out" class="btn-header btn-logout">Logout</a>
        </div>
      </div>
    <% } else { %>
      <div class="form-container" style="margin: 2rem auto; max-width: 400px; text-align: center;">
        <h2>Welcome!</h2>
        <p>Don't have an account?</p>
        <a href="/register" class="btn">Register now</a>
          <div style="margin-top: 1rem;">
            <small>If you already have an account, <a href="/log-in" class="index-login">you can log in here</a>.</small>
          </div>
      </div>
    <% } %>
  </body>
</html>
