<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/required-asterisk.css" />
    <title>New Post</title>
  </head>
  <body>
    <div class="form-container" style="margin: 2rem auto; max-width: 500px">
      <h2>Create a New Post</h2>
      <form action="/posts/new" method="POST">
        <% if (errors && Array.isArray(errors)) { %>
          <% errors.filter(e => !e.path).forEach(e => { %>
            <div class="error-message global-error-message"><%= e.msg %></div>
          <% }) %>
        <% } %>
        <div class="form-group">
          <label for="post_title" style="padding: 8px 0; display: inline-block"
            >Title <span class="required-asterisk">(*)</span></label>
          <input
            id="post_title"
            name="post_title"
            type="text"
            minlength="3"
            maxlength="40"
            required
            style="width: 100%; display: inline-block"
          />
          <% if (errors && Array.isArray(errors)) { %>
            <% errors.filter(e => e.path === 'post_title').forEach(e => { %>
              <div class="error-message"><%= e.msg %></div>
            <% }) %>
          <% } %>
        </div>
        <div class="form-group">
          <label
            for="post_content"
            style="padding: 8px 0; display: inline-block"
            >Post message <span class="required-asterisk">(*)</span></label>
          <textarea
            id="post_content"
            name="post_content"
            minlength="5"
            maxlength="300"
            rows="5"
            required
            style="width: 100%; display: inline-block"
          ></textarea>
          <% if (errors && Array.isArray(errors)) { %>
            <% errors.filter(e => e.path === 'post_content').forEach(e => { %>
              <div class="error-message"><%= e.msg %></div>
            <% }) %>
          <% } %>
        </div>
        <button type="submit" class="btn btn-green">Send Post</button>
      </form>
    </div>
    <div style="max-width: 500px; margin: 0 auto; text-align: left">
      <div style="margin-bottom: 1rem; display: flex; justify-content: center">
        <a href="/" class="btn">Go Home</a>
      </div>
    </div>
  </body>
</html>
