<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClubHouse | <%= title %></title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/required-asterisk.css" />
  </head>
  <body class="centered">
    <div class="form-container">
            <div class="highlight-login-message">
              <span class="highlight-login-text">Don't have an account?</span>
              <a href="/register" class="highlight-login-link-red">Register here</a>
            </div>
      <h2>Login</h2>
      <form action="/log-in" method="POST" class="modern-form">
                <% if (errors && Array.isArray(errors)) { %>
                  <% errors.filter(e => !e.path).forEach(e => { %>
                    <div class="error-message global-error-message"><%= e.msg %></div>
                  <% }) %>
                <% } %>
        <div class="form-group">
          <label for="email">Email <span class="required-asterisk">(*)</span>:</label>
          <input
            type="email"
            id="email"
            name="email"
            minlength="3"
            maxlength="40"
            required
            autocomplete="email"
          />
          <% if (errors && Array.isArray(errors)) { %>
            <% errors.filter(e => e.path === 'email').forEach(e => { %>
              <div class="error-message"><%= e.msg %></div>
            <% }) %>
          <% } %>
        </div>
        <div class="form-group">
          <label for="password">Password <span class="required-asterisk">(*)</span>:</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            autocomplete="current-password"
          />
          <% if (errors && Array.isArray(errors)) { %>
            <% errors.filter(e => e.path === 'password').forEach(e => { %>
              <div class="error-message"><%= e.msg %></div>
            <% }) %>
          <% } %>
        </div>
        <button type="submit" class="btn">Login</button>
      </form>
    </div>
  </body>
</html>
