<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/required-asterisk.css" />
    <title>Members Area</title>
  </head>
  <body>
    <div class="container" style="margin: 2rem auto; max-width: 400px; text-align: center;">
      <h2>Admin Panel</h2>
        <% if (isAdmin) { %>
          <h3 style="margin-top: 40px; color: red; font-size: 36px;">You are admin</h3>
        <% } else { %>
          <% if (errors && Array.isArray(errors) && errors.length > 0) { %>
            <% errors.forEach(e => { %>
              <div class="error-message global-error-message"><%= e.msg %></div>
            <% }) %>
          <% } %>
          <form action="/admin/promote" method="POST" class="modern-form">
            <div class="form-group">
              <label for="admin_passcode">Admin passcode <span class="required-asterisk">(*)</span>:</label>
              <input type="password" name="admin_passcode" id="admin_passcode" required autocomplete="off" />
            </div>
            <button type="submit" class="btn">Promote to admin</button>
          </form>
        <% } %>
        <div style="margin-top: 1rem;">
          <a href="/">Back to Home</a>
        </div>
    </div>
  </body>
</html>
